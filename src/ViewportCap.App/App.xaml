<Application x:Class="ViewportCap.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF111827"/><SolidColorBrush x:Key="BorderBrush" Color="#FF334155"/><SolidColorBrush x:Key="MutedBrush" Color="#FF94A3B8"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#FFF8FAFC"/><Setter Property="Background" Value="#FF0B1220"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF8FAFC"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#FF1E293B"/><Setter Property="Foreground" Value="#FFF8FAFC"/><Setter Property="BorderBrush" Value="#FF334155"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FF0F172A"/><Setter Property="Foreground" Value="#FFF8FAFC"/><Setter Property="BorderBrush" Value="#FF334155"/><Setter Property="Padding" Value="6,4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF0F172A"/><Setter Property="Foreground" Value="#FFF8FAFC"/><Setter Property="BorderBrush" Value="#FF334155"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFF8FAFC"/></Style>
  </Application.Resources>
</Application>
