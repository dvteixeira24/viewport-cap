<Window x:Class="ViewportCap.App.Windows.ReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review recording" Width="820" Height="700" MinWidth="720" MinHeight="600" WindowStartupLocation="CenterScreen"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#FF0F172A"><MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" MediaOpened="Preview_MediaOpened" MediaFailed="Preview_MediaFailed"/></Border><StackPanel Grid.Row="1" Margin="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="In"/><Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" ValueChanged="TrimChanged"/><TextBlock x:Name="StartText" Grid.Column="2"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Out"/><Slider x:Name="EndSlider" Grid.Column="1" Minimum="0" ValueChanged="TrimChanged"/><TextBlock x:Name="EndText" Grid.Column="2"/></Grid><Button x:Name="PlayButton" Content="Play" Click="Play_Click" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Row="2"><WrapPanel><ComboBox x:Name="FormatBox" Width="130" SelectionChanged="FormatChanged"/><ComboBox x:Name="QualityBox" Width="130"/><ComboBox x:Name="FpsBox" Width="100"/><ComboBox x:Name="ScaleBox" Width="130"/><CheckBox x:Name="KeepAudioBox" Content="Keep audio"/></WrapPanel><TextBlock x:Name="StatusText"/><ProgressBar x:Name="Progress" Height="8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Discard" Click="Discard_Click"/><Button Content="Save As..." Click="SaveAs_Click"/><Button Content="Export" Click="Export_Click"/></StackPanel></StackPanel></Grid></Window>
