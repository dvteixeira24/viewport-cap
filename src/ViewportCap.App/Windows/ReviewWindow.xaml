<Window x:Class="ViewportCap.App.Windows.ReviewWindow" Style="{DynamicResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review recording" Width="960" Height="820" MinWidth="760" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="28,20,28,16">
      <TextBlock Text="Review recording" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Preview your clip, adjust the trim, then export." Style="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#181818" CornerRadius="4" Margin="28,0">
      <Border x:Name="PreviewHost" Margin="1"/>
    </Border>
    <Grid Grid.Row="2" Margin="28,16,28,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="Trim _start" Target="{Binding ElementName=StartSlider}" VerticalAlignment="Center" Padding="0,0,16,0"/>
      <Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" ValueChanged="TrimChanged" VerticalAlignment="Center" AutomationProperties.Name="Trim start in seconds"/>
      <TextBlock x:Name="StartText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      <Label Grid.Row="1" Content="Trim _end" Target="{Binding ElementName=EndSlider}" VerticalAlignment="Center" Padding="0,0,16,0"/>
      <Slider x:Name="EndSlider" Grid.Row="1" Grid.Column="1" Minimum="0" ValueChanged="TrimChanged" VerticalAlignment="Center" Margin="0,8" AutomationProperties.Name="Trim end in seconds"/>
      <TextBlock x:Name="EndText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
      <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="PlayButton" Content="Play" Click="Play_Click"/>
        <Button x:Name="OpenPreviewButton" Content="Open in default player" Click="OpenPreview_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="3" Padding="28,20" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
      <StackPanel>
        <TextBlock Text="Export options" Style="{DynamicResource SectionHeading}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><Label Content="_Format" Target="{Binding ElementName=FormatBox}"/><ComboBox x:Name="FormatBox" SelectionChanged="FormatChanged"/></StackPanel>
          <StackPanel Grid.Column="2"><Label Content="_Quality" Target="{Binding ElementName=QualityBox}"/><ComboBox x:Name="QualityBox"/></StackPanel>
          <StackPanel Grid.Column="4"><Label Content="Frame _rate (fps)" Target="{Binding ElementName=FpsBox}"/><ComboBox x:Name="FpsBox"/></StackPanel>
          <StackPanel Grid.Column="6"><Label Content="_Scale" Target="{Binding ElementName=ScaleBox}"/><ComboBox x:Name="ScaleBox"/></StackPanel>
        </Grid>
        <CheckBox x:Name="KeepAudioBox" Content="Keep _audio" Margin="0,12,0,0"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" AutomationProperties.Name="Export progress"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="28,16">
      <Grid>
        <Button Content="_Discard" Click="Discard_Click" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Save _as…" Click="SaveAs_Click"/>
          <Button Content="E_xport" Click="Export_Click" Style="{DynamicResource PrimaryButton}" MinWidth="112" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
