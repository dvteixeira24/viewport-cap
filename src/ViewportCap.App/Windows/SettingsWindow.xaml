<Window x:Class="ViewportCap.App.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="viewport-cap settings" Width="580" Height="620" MinWidth="520" MinHeight="520" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Icon="pack://application:,,,/Assets/app.ico">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer><StackPanel>
 <TextBlock Text="viewport-cap" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Capture a region from anywhere." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,18"/>
 <TextBlock Text="Global hotkey"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,4,0,14"/>
 <TextBlock Text="Output folder"/><Grid Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderBox"/><Button Grid.Column="1" Content="Browse..." Click="Browse_Click"/></Grid>
 <TextBlock Text="Countdown (seconds)"/><ComboBox x:Name="CountdownBox" Margin="0,4,0,14"/><TextBlock Text="Default export format"/><ComboBox x:Name="FormatBox" Margin="0,4,0,14"/>
 <TextBlock Text="Audio at capture time"/><ComboBox x:Name="AudioModeBox" Margin="0,4,0,14"/><CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0,4,0,16"/><TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}"/>
 </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save" Click="Save_Click"/></StackPanel></Grid>
</Window>
