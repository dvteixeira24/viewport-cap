<Window x:Class="ViewportCap.App.Windows.RecordingHudWindow" Style="{DynamicResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording" Width="400" Height="188" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">
  <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="20,16">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#C42B1C" Margin="0,0,8,0"/>
          <TextBlock Text="Recording" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="00:00" FontSize="24" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
      </Grid>
      <TextBlock x:Name="AudioText" Style="{DynamicResource SecondaryText}" Margin="0,4,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="Cancel_Click"/>
        <Button Content="_Stop" Click="Stop_Click" Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="WarningText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
  </Border>
</Window>
