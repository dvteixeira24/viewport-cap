<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ViewportCap.Core\ViewportCap.Core.csproj" />
    <ProjectReference Include="..\ViewportCap.Encoding\ViewportCap.Encoding.csproj" />
    <ProjectReference Include="..\ViewportCap.Capture\ViewportCap.Capture.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>viewport-cap</AssemblyName>
    <RootNamespace>ViewportCap.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
  </ItemGroup>

  <!-- A dev build sits beside no ffmpeg.exe; copy the fetched binary so export works there like in dist/publish. -->
  <Target Name="CopyFfmpeg" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\ffmpeg.exe')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\tools\ffmpeg\ffmpeg.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
